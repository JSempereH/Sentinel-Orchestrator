# Copy this file to .env and fill in your CDSE OAuth client credentials.
CDSE_CLIENT_ID=your_client_id
CDSE_CLIENT_SECRET=your_client_secret
# Optional: required for direct OData product downloads with CDSE's standard auth.
# CDSE_USERNAME=your_cdse_username
# CDSE_PASSWORD=your_cdse_password

# Optional settings.
CDSE_BACKEND_URL=https://openeo.dataspace.copernicus.eu
CDSE_OUTPUT_DIR=output

# Optional CDSE API overrides.
CDSE_CATALOG_URL=https://catalogue.dataspace.copernicus.eu/odata/v1/Products
CDSE_DOWNLOAD_URL=https://download.dataspace.copernicus.eu/odata/v1/Products
CDSE_TOKEN_URL=https://identity.dataspace.copernicus.eu/auth/realms/CDSE/protocol/openid-connect/token
# Download resilience: connection timeout, per-read timeout, and retry count.
CDSE_CONNECT_TIMEOUT_S=30
CDSE_READ_TIMEOUT_S=600
CDSE_DOWNLOAD_RETRIES=6

# Auxiliary data providers.
# CDS/ADS credentials can also be stored in ~/.cdsapirc. Never put real tokens
# in this file if it is going to be committed.
# CDS_API_URL=https://cds.climate.copernicus.eu/api
# CDS_API_KEY=your_personal_access_token
# CAMS_API_URL=https://ads.atmosphere.copernicus.eu/api
# CAMS_API_KEY=your_personal_access_token
# CAMS_DATA_FORMAT=netcdf_zip
# OPENAQ_API_KEY=your_openaq_v3_key

# Required for the "ecostress" sensor and sentinel1_backend="hyp3_rtc" (ASF
# HyP3 sits behind the same urs.earthdata.nasa.gov login). NASA Earthdata
# Cloud uses a real OAuth2 flow that ~/.netrc Basic Auth cannot complete -
# generate a personal token at https://urs.earthdata.nasa.gov/profile ->
# Generate Token.
# EARTHDATA_BEARER_TOKEN=your_earthdata_user_token

# Alternative to EARTHDATA_BEARER_TOKEN for sentinel1_backend="hyp3_rtc"
# only - hyp3_sdk also accepts a plain Earthdata username/password.
# EARTHDATA_USERNAME=your_earthdata_username
# EARTHDATA_PASSWORD=your_earthdata_password
