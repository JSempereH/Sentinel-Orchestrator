# Copy this file to .env and fill in your values. Never commit .env.

# Shared secret every client (script, UI, another service) must send as
# "Authorization: Bearer <token>". Required - the worker rejects every job
# request until this is set.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
WORKER_API_TOKEN=

# Optional overrides (defaults shown):
# WORKER_OUTPUT_DIR=./runs
# MAX_DOWNLOAD_WORKERS=4
# MAX_CONCURRENT_JOBS=1  # jobs can need several GB of RAM each
# Requests beyond these are rejected at submission with HTTP 422 (0 disables):
# MAX_AOI_KM2=10000
# MAX_PRODUCTS_PER_SENSOR=100
# MAX_ESTIMATED_GB=8  # estimated in-memory cube size; peak RAM is up to ~2x
# Jobs and disk (see docs/platform.md, "Production operation"):
# JOB_TIMEOUT_HOURS=12      # a running job is stopped after this (0 disables)
# JOB_RETENTION_DAYS=30     # finished jobs and their files are deleted after this (0 keeps them)
# KEEP_WORK_DIR=false       # true keeps downloads/subsets of successful jobs
# MIN_FREE_DISK_GB=20       # below this, submissions get HTTP 507 (0 disables)
# JOB_PROCESS_ISOLATION=true  # each job in its own process (needed for cancel/timeout)
# LOG_FORMAT=text           # or json, one object per line
# Docker only (docker-compose.yml): hard memory cap of the container
# WORKER_MEM_LIMIT=12g

# --- citycube credentials ---
# Read directly by citycube (ClientConfig.from_env() and the
# auxiliary providers), exactly as when running its CLI by hand.
CDSE_CLIENT_ID=
CDSE_CLIENT_SECRET=
# CDSE_USERNAME=
# CDSE_PASSWORD=

# Optional auxiliary providers:
# CDS_API_URL=https://cds.climate.copernicus.eu/api
# CDS_API_KEY=
# CAMS_API_URL=https://ads.atmosphere.copernicus.eu/api
# CAMS_API_KEY=
# CAMS_DATA_FORMAT=netcdf_zip
# OPENAQ_API_KEY=

# Required for the "ecostress" sensor, and for sentinel1_backend="hyp3_rtc"
# (ASF HyP3 sits behind the same urs.earthdata.nasa.gov login). NASA
# Earthdata Cloud uses a real OAuth2 flow that ~/.netrc Basic Auth cannot
# complete - generate a personal token at
# https://urs.earthdata.nasa.gov/profile -> Generate Token.
# EARTHDATA_BEARER_TOKEN=

# Alternative to EARTHDATA_BEARER_TOKEN for sentinel1_backend="hyp3_rtc"
# only - hyp3_sdk also accepts a plain Earthdata username/password.
# EARTHDATA_USERNAME=
# EARTHDATA_PASSWORD=
